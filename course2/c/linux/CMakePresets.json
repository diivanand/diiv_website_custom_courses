{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Linux tier — -O2 (run this on the Jetson / Pi)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "COURSE2_OPT": "2", "COURSE2_SANITIZE": "OFF" }
    },
    {
      "name": "debug",
      "displayName": "Linux tier — -O0, ASan+UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "COURSE2_OPT": "0", "COURSE2_SANITIZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
