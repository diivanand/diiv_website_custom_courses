# macOS
.DS_Store

# Local AI-assistant context (not published)
CLAUDE.md
.claude/

# Python / uv (uv.lock IS tracked)
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# CMake / C / C++ build output
build/
# CLion default build dirs (cmake-build-debug, cmake-build-release, …)
cmake-build-*/
CMakeUserPresets.json
*.o
*.obj
*.elf
*.map
compile_commands.json

# STM32CubeIDE leftovers (if a module is ever opened in the IDE) — scoped to the
# firmware tree so lab dirs named debug/release are never swallowed silently
course3/firmware/*/Debug/
course3/firmware/*/Release/
*.launch

# LTspice temp output (keep .asc schematics)
*.raw
*.log.raw
*.op.raw

# JetBrains IDEs (CLion, PyCharm) — out/ anchored to the repo root only, so
# course3/media/out/ (Module 9 test media) stays tracked
.idea/
*.iml
/out/

# Other editors
.vscode/

# SwiftPM build output
.build/

# Apple metal-cpp drop-in (downloaded, not tracked)
course4/third_party/metal-cpp/
